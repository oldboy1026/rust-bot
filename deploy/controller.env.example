# systemd EnvironmentFile syntax; this is not loaded by npm/start.sh.
PORT=3220
LISTEN_HOST=127.0.0.1
CONTROLLER_DATA_DIR=/var/lib/adminlogger-controller
# Optional Steam CM HTTP proxy:
# STEAM_HTTP_PROXY=http://127.0.0.1:7890
# Download of the fixed bundled C# plugin remains disabled by default.
# ALLOW_PLUGIN_DOWNLOAD=1
