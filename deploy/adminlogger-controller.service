[Unit]
Description=AdminLogger Steam and Rust plugin controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=adminlogger
Group=adminlogger
WorkingDirectory=/opt/adminlogger-controller
EnvironmentFile=/etc/adminlogger-controller.env
ExecStart=/usr/bin/node /opt/adminlogger-controller/src/main.js
StateDirectory=adminlogger-controller
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/adminlogger-controller

[Install]
WantedBy=multi-user.target
